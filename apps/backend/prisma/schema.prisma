generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  POINT_FOCAL
}

enum RequestStatus {
  RECEIVED
  UNDER_REVIEW
  ADDITIONAL_DOCUMENTS_REQUESTED
  APPROVED
  REJECTED
  RESOURCES_ASSIGNED
  CLOSED
}

enum RequestType {
  GOVERNMENT_SUBDOMAIN
  HOSTING_SPACE
  SUBDOMAIN_AND_HOSTING
  RESOURCE_MODIFICATION
  ACCESS_RESET
  OTHER
}

enum PlatformType {
  INSTITUTIONAL_SITE
  WEB_APPLICATION
  SERVICE_PORTAL
  INTRANET
  OTHER
}

enum AudienceType {
  CITIZENS
  BUSINESSES
  PUBLIC_AGENTS
  INSTITUTIONAL_PARTNERS
  INTERNAL_ONLY
}

enum CriticalityLevel {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DomainChoiceRank {
  FIRST
  SECOND
  THIRD
}

enum DocumentType {
  OFFICIAL_REQUEST_LETTER
  FOCAL_POINT_DESIGNATION
  ADDITIONAL_DOCUMENT
}

enum AccessTransmissionMode {
  PLATFORM
  OFFICIAL_LETTER
  OFFICIAL_EMAIL
  PHYSICAL_HANDOVER
}

enum AuditAction {
  REQUEST_CREATED
  STATUS_CHANGED
  DOCUMENT_ADDED
  ADMIN_NOTE_ADDED
  RESOURCE_ASSIGNED
  REQUEST_CLOSED
  USER_LOGIN
}

enum ConversationType {
  REQUEST
  GENERAL
}

enum ConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  middleName String?
  phone     String?
  functionTitle String?
  department String?
  ministryId String?
  ministry   Ministry? @relation("UserMinistry", fields: [ministryId], references: [id])
  otherInstitutionName String?
  roles     UserRole[] @default([AGENT])
  isActive  Boolean    @default(true)

  instructedRequests ResourceRequest[] @relation("RequestInstructor")
  focalRequests      ResourceRequest[] @relation("PointFocalRequests")
  focalConversations Conversation[] @relation("PointFocalConversations")
  sentMessages       Message[] @relation("MessageSender")
  conversationReads  ConversationRead[]
  auditEvents        AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ministry {
  id          String  @id @default(uuid())
  name        String  @unique
  shortName   String?
  officialEmailDomain String?
  isActive    Boolean @default(true)

  requests ResourceRequest[]
  users    User[] @relation("UserMinistry")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResourceRequest {
  id     String @id @default(uuid())
  number String @unique

  focalLastName   String
  focalMiddleName String
  focalFirstName  String
  focalFunction   String
  focalDepartment String
  focalPhone      String
  focalEmail      String

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id])
  otherInstitutionName String?

  requestTypes   RequestType[]
  requestDetails String?

  platformName     String
  platformType     PlatformType
  audience         AudienceType
  criticality      CriticalityLevel @default(NORMAL)
  existingUrl      String?
  targetDate       DateTime?
  officialPurpose  String
  technicalContact String?

  status RequestStatus @default(RECEIVED)

  instructorId String?
  instructor   User?   @relation("RequestInstructor", fields: [instructorId], references: [id])

  pointFocalUserId String?
  pointFocalUser   User? @relation("PointFocalRequests", fields: [pointFocalUserId], references: [id])

  assignedDomain       String?
  hostingAssigned      Boolean @default(false)
  resourcesCreatedAt   DateTime?
  accessDeliveredAt    DateTime?
  accessTransmissionMode AccessTransmissionMode?
  administrativeNotes  String?
  publicObservation    String?
  rejectionReason      String?

  domainChoices RequestDomainChoice[]
  documents     RequestDocument[]
  auditEvents   AuditEvent[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ministryId])
  @@index([pointFocalUserId])
  @@index([createdAt])
}

model RequestDomainChoice {
  id        String           @id @default(uuid())
  requestId String
  request   ResourceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rank      DomainChoiceRank
  prefix    String
  fullDomain String

  createdAt DateTime @default(now())

  @@unique([rank, requestId])
  @@index([prefix])
}

model RequestDocument {
  id          String       @id @default(uuid())
  requestId   String
  request     ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type        DocumentType
  originalName String
  fileName    String
  mimeType    String
  size        Int
  localPath   String
  uploadedBy  String?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([type])
}

model Conversation {
  id     String @id @default(uuid())
  type   ConversationType
  status ConversationStatus @default(OPEN)

  requestId String?
  request   ResourceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  pointFocalUserId String
  pointFocalUser   User @relation("PointFocalConversations", fields: [pointFocalUserId], references: [id], onDelete: Cascade)

  subject       String?
  lastMessageAt DateTime?

  messages Message[]
  reads    ConversationRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, requestId, pointFocalUserId])
  @@index([type])
  @@index([status])
  @@index([requestId])
  @@index([pointFocalUserId])
  @@index([lastMessageAt])
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body String?
  attachments MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model ConversationRead {
  id             String @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([lastReadAt])
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  originalName String
  fileName     String
  mimeType     String
  size         Int
  localPath    String

  createdAt DateTime @default(now())

  @@index([messageId])
}

model AuditEvent {
  id        String      @id @default(uuid())
  action    AuditAction
  message   String
  requestId String?
  request   ResourceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([actorId])
  @@index([createdAt])
}
